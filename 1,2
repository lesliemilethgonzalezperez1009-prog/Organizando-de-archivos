## dia 2 : ruta 
carpeta= {
    "pdf" : "PDF",
    "jpg" : "IMAGENES",
    "png" : "IMAGENES",
    "doc" : "DOCUMENTOS",
    "xlsx" : "HOJAS DE CALCULO",
    "txt" : "TEXTOS",
}

source_folder = "carpeta de prueba"
Files = os.listdir(source_folder) 

for file in Files:
    extension = file.split(".")[-1] 
    nombre_carpeta = carpeta.get(extension)
    if nombre_carpeta is not None:
        destination_folder = os.path.join("archivos_organizados", carpeta[extension])
        os.makedirs(destination_folder, exist_ok=True)

        principal = os.path.join(source_folder, file)
        final = os.path.join(destination_folder, file)

        shutil.move(principal, final)

## ahora todos los archivos de "carpeta de prueba" estan en la carpeta "archivos_organizados".
